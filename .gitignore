*.tar.zst
*.tar.gz
*.bin
*.itb
*.img
*.ko
*.apk
*.ipk
*.manifest

# Scratch
tmp/
*.log
*.orig
*.rej
__pycache__/
*.pyc

# Editors and OS cruft
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
