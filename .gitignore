# Build outputs. Never commit these: they are large, they are reproducible, and
# they belong in a GitHub release, not in git history.

dist/
out/
build/

# Firmware and package artifacts
*.tar.zst
*.tar.gz
*.bin
*.itb
*.img
*.ko
*.apk
*.ipk
*.manifest

# Scratch
tmp/
*.log
*.orig
*.rej
__pycache__/
*.pyc

# OpenWrt build trees.  The workflows clone OpenWrt into these paths, inside the
# checkout (upload-artifact refuses a path with '..' in it, and cloning into the
# repository's own openwrt/ directory would collide with the overlay).
owrt-build/
owrt-kernel-check/

# Editors and OS cruft
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
