// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
/*
 * vG/econet vGP-42X6V1 -- GPON ONU on the Airoha/Econet EN7523 SoC
 * Board bring-up for OpenWrt.
 *
 * Milestones already validated on real hardware:
 *   M2/M3: UART + NAND (FIT splits kernel/rootfs/rootfs_data) + UBI overlay on mtd7 + PCIe/WiFi
 *   M4   : internal Ethernet -- FE/QDMA/GDMP + GDM1 + GSW (MT7530 compatible) -> 4 LAN ports
 *
 * Data sources:
 *  - /proc/mtd, /proc/meminfo, /proc/cmdline (see docs/reverse-engineering.md)
 *  - the stock device tree extracted from the vendor FIT image
 *  - eth/gdm1/switch/gsw_port/mdio nodes: from the upstream EN7523 patch series
 *    (OpenWrt PR #20104, patches 930-42..930-51) -- see docs/ethernet.md
 *
 * NOTE: the PON nodes (xpon / xpon_phy / pon_pcs / laser) are NOT here -- they need a
 * separate config + PON patch (see openwrt/pon/README.md). M4 only enables Ethernet/switch,
 * so the optical part is still in the "no driver yet" state.
 */
/dts-v1/;

/* ATF is placed at the start of DRAM by the bootloader (tcboot/U-Boot), as in en7523-evb.dts */
/memreserve/ 0x80000000 0x200000;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/reset/airoha,en7523-reset.h>
#include "en7523.dtsi"

/ {
	model = "vG/econet vGP-42X6V1";
	compatible = "econet,vgp-42x6v1", "airoha,en7523";

	aliases {
		serial0 = &uart1;
		/* status LEDs for diag.sh / init.d/led (get_dt_led boot|running|...) */
		led-boot = &led_power;
		led-running = &led_power;
		led-failsafe = &led_power;
		led-upgrade = &led_power;
	};

	chosen {
		bootargs = "console=ttyS0,115200n8 earlycon";
		stdout-path = "serial0:115200n8";
		linux,usable-memory-range = <0x80200000 0x1fe00000>;
	};

	/*
	 * Real RAM = 512 MB. Read live: MemTotal 480136 kB (~32 MiB at the start is reserved
	 * by NPU/ATF). The stock DT declares 0x40000000 (1 GiB) -- WRONG, do not use.
	 */
	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x20000000>;
	};

	/*
	 * ------------------------------------------------------------------
	 * I2C0 (0x1fbf8000) -- the optical bus (BOSA/EN7571 at 0x70)
	 * ------------------------------------------------------------------
	 * On the stock firmware the DDMI values are read through the PON PHY
	 * block's *internal* I2C master, while the community tree and the one
	 * public EN7523 port (Zyxel PX3321-T1) both put the EN7571 on the SoC's
	 * I2C0 at address 0x70. This is the experiment that settles it: enable
	 * the bus and the driver, then scan for 0x70 with `i2cdetect -y -r 0`.
	 * - airoha_caps: max_clk_div 0xfff, atomic polling, no CFG2 register
	 *   (patch 930-52, taken from the airoha_en7523_all branch).
	 * - fixed 20 MHz clock, 100 kHz bus. No pinctrl: the I2C pads use the
	 *   SoC defaults.
	 *
	 * Address 0x70 was confirmed on real hardware (2026-10-08): an
	 * `i2cdetect -y -r 0` scan answers at 0x70, so the EN7571 is on this bus
	 * and the read-only probing phase is over. The child node below hands
	 * the part to the optical frontend driver, which writes its bring-up
	 * sequence and the board BOB calibration into the laser-diode driver.
	 * Keep the fibre unplugged and the PON port dark while that driver is
	 * brought up: the stock LED map calls this board's TX-disable line
	 * GPIO16, and nothing in this DTS claims it, so the dark state rests on
	 * the BOSA's own power-up state rather than on Linux.
	 */
	i2cclock: i2cclock@0 {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <20000000>;
	};

	i2c0: i2c0@1fbf8000 {
		compatible = "airoha,en7523-i2c";
		reg = <0x1fbf8000 0x100>;
		clocks = <&i2cclock>;
		clock-frequency = <100000>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		/*
		 * BOSA + EN7571 laser-diode driver / limiting amplifier.
		 *
		 * firmware-name points at this unit's own BOB calibration blob
		 * (400 B, magic 0x07050701 at byte 0x94 -- the byte lddla_bob_import()
		 * uses to identify both the chip family and the 32-bit word
		 * endianness of the source). The file is installed at
		 * /lib/firmware/airoha/en7571_bob.bin.
		 *
		 * Deliberately no nvmem-cells: the driver tries an nvmem cell named
		 * "calibration" first and falls back to firmware-name when there is
		 * none. Reading the BOB straight out of flash later would mean
		 * pointing a cell at the factory block (BOB at 0x6F00000+0x497).
		 */
		en7571: lddla@70 {
			compatible = "airoha,en7571";
			reg = <0x70>;
			firmware-name = "airoha/en7571_bob.bin";

			/*
			 * MANDATORY for this node to act as an optical frontend
			 * *provider*: optical/core.c devm_optical_frontend_get_optional()
			 *     -> fwnode_property_get_reference_args(fwnode,
			 *           "optical-frontends",
			 *           "#optical-frontend-cells", 0, index, &args);
			 *     if (ret) { if (ret == -ENOENT) return NULL;
			 *                return ERR_PTR(ret); }   <- -EINVAL
			 * Without this property the lookup returns -EINVAL (not
			 * -EPROBE_DEFER), so airoha_xpon_probe() takes the "failed to
			 * get optical frontend" branch -> "error on register xPON MAC"
			 * -> the whole xPON stack is torn down.
			 */
			#optical-frontend-cells = <0>;
		};
	};

	/*
	 * ------------------------------------------------------------------
	 * Internal Ethernet (M4)
	 * ------------------------------------------------------------------
	 * EN7523 has a Frame Engine (FE) + 2 QDMA blocks (PDMA/QDMA) + GDMP, and 3
	 * internal MAC ports called GDM:
	 *   GDM1 -> internal switch (GSW) -> 4 LAN PHY ports (phy-mode "internal")
	 *   GDM2 -> PON MAC (SGMII 2500Base-X) -- needs a PCS node, NOT enabled in M4
	 *   GDM3 -> USB serdes                              -- NOT enabled in M4
	 * Driver: drivers/net/ethernet/airoha/airoha_eth.c (CONFIG_NET_AIROHA=y).
	 * The GSW switch is MT7530 compatible -> use the mt7530 DSA driver (CONFIG_NET_DSA_MT7530_MMIO).
	 * Addresses/IRQs/resets come from the upstream patch series (930-42..930-51), already
	 * cross-checked against Kiwironic's working EN7523 board DT.
	 */
	eth: ethernet@1fb50000 {
		compatible = "airoha,en7523-eth";
		status = "okay";

		reg = <0x1fb50000 0x2600>,
		      <0x1fb54000 0x2000>,
		      <0x1fb56000 0x2000>,
		      <0x1fbf9000 0x1000>;
		reg-names = "fe", "qdma0", "qdma1", "gdmp";

		resets = <&scu EN7523_FE_RST>,
			 <&scu EN7523_FE_PDMA_RST>,
			 <&scu EN7523_FE_QDMA_RST>,
			 <&scu EN7523_DUAL_HSI0_MAC_RST>,
			 <&scu EN7523_DUAL_HSI1_MAC_RST>,
			 <&scu EN7523_HSI_MAC_RST>,
			 <&scu EN7523_GDMP_RST>;
		reset-names = "fe", "pdma", "qdma",
			      "hsi0-mac", "hsi1-mac", "hsi-mac", "gdmp";

		interrupts = <GIC_SPI 37 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 55 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 56 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 57 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 38 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 58 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 59 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 60 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 49 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH>;

		memory-region = <&qdma0_buf>, <&qdma1_buf>;
		memory-region-names = "qdma0-buf", "qdma1-buf";

		#address-cells = <1>;
		#size-cells = <0>;

		gdm1: ethernet@1 {
			compatible = "airoha,eth-mac";
			reg = <1>;
			/* GDM1 only supports "internal" when connected to the internal switch */
			phy-mode = "internal";
			status = "okay";

			/*
			 * The identity of this unit comes out of its own flash, read by the
			 * kernel: the `ethaddr` variable of the U-Boot environment (see the
			 * u-boot-env partition) is exposed as an nvmem cell, and the driver
			 * picks it up through of_get_ethdev_address(). Nothing in this
			 * repository carries a per-unit value any more, and no boot-time
			 * userspace script assigns a MAC.
			 *
			 * Without a cell the driver's of_get_ethdev_address() fails and it
			 * calls eth_hw_addr_random(): eth0 gets a new address on every boot
			 * (MEASURED: dmesg "generated random MAC address ...",
			 * addr_assign_type = 1 = NET_ADDR_RANDOM). If the nvmem provider is
			 * not up yet the call returns -EPROBE_DEFER and the driver defers
			 * (airoha_eth.c), so the address is always read before the netdev is
			 * registered.
			 *
			 * The index is the offset ADDED to the stored address: there is only
			 * one address on the board, and drivers/nvmem/layouts/u-boot-env.c
			 * runs eth_addr_add(mac, index) when the index is non-zero. Index 0 is
			 * the address exactly as flashed -- the one printed on the label --
			 * and is what the CPU port (GDM1) and the LAN bridge use.
			 */
			nvmem-cells = <&ethaddr 0>;
			nvmem-cell-names = "mac-address";

			fixed-link {
				speed = <10000>;
				full-duplex;
				pause;
			};
		};
	};

	switch: switch@1fb58000 {
		compatible = "airoha,en7523-switch";
		reg = <0x1fb58000 0x8000>;
		resets = <&scu EN7523_GSW_RST>;
		interrupt-controller;
		#interrupt-cells = <1>;
		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI 31 IRQ_TYPE_LEVEL_HIGH>;
		status = "okay";

		#address-cells = <1>;
		#size-cells = <1>;

		/*
		 * Per-port identity comes from flash too: DSA reads each port's MAC with
		 * of_get_mac_address() (net/dsa/dsa.c) and uses it verbatim when it is not
		 * all-zero (net/dsa/port.c, otherwise the port inherits its conduit's
		 * address). The index is again the offset added to the single stored
		 * address, so lan1..lan4 get base+1..base+4 and never collide with GDM1
		 * (base+0) or the two radios (base+6, base+7).
		 */
		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			gsw_port1: port@1 {
				reg = <1>;
				label = "lan1";
				phy-mode = "internal";
				phy-handle = <&gsw_phy1>;
				status = "okay";

				nvmem-cells = <&ethaddr 1>;
				nvmem-cell-names = "mac-address";
			};

			gsw_port2: port@2 {
				reg = <2>;
				label = "lan2";
				phy-mode = "internal";
				phy-handle = <&gsw_phy2>;
				status = "okay";

				nvmem-cells = <&ethaddr 2>;
				nvmem-cell-names = "mac-address";
			};

			gsw_port3: port@3 {
				reg = <3>;
				label = "lan3";
				phy-mode = "internal";
				phy-handle = <&gsw_phy3>;
				status = "okay";

				nvmem-cells = <&ethaddr 3>;
				nvmem-cell-names = "mac-address";
			};

			gsw_port4: port@4 {
				reg = <4>;
				label = "lan4";
				phy-mode = "internal";
				phy-handle = <&gsw_phy4>;
				status = "okay";

				nvmem-cells = <&ethaddr 4>;
				nvmem-cell-names = "mac-address";
			};

			/* port 6 = CPU port, connected to MAC GDM1 */
			port@6 {
				reg = <6>;
				ethernet = <&gdm1>;
				phy-mode = "internal";

				fixed-link {
					speed = <10000>;
					full-duplex;
					pause;
				};
			};
		};

		mdio: mdio {
			#address-cells = <1>;
			#size-cells = <0>;

			gsw_phy1: ethernet-phy@9 {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <9>;
			};

			gsw_phy2: ethernet-phy@a {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <10>;
			};

			gsw_phy3: ethernet-phy@b {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <11>;
			};

			gsw_phy4: ethernet-phy@c {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <12>;
			};
		};
	};
};

/*
 * QDMA DMA area. en7523.dtsi already has a reserved-memory node (5 regions for
 * the NPU, 0x84000000-0x86E00000), so here we extend it by path overlay -- do NOT
 * create a second reserved-memory node (dtc will report a duplicate node name).
 *
 * 0x87000000-0x8A000000 is inside the 512 MB DRAM, right after the dtsi NPU region.
 * "no-map" => the kernel does not map this area; only the eth driver uses it as ring buffers.
 */
&{/reserved-memory} {
	qdma0_buf: qdma0-buf@87000000 {
		no-map;
		reg = <0x87000000 0x02000000>;
	};

	qdma1_buf: qdma1-buf@89000000 {
		no-map;
		reg = <0x89000000 0x01000000>;
	};
};

/*
 * ------------------------------------------------------------------
 * img16: drop the 2 old "GPIO banks", use the airoha,en7523-pinctrl driver
 * ------------------------------------------------------------------
 * The old banks (`airoha,en7523-gpio` declared in en7523.dtsi) map
 * 0x1fbf0204/0200/0220/0214 + 0x1fbf0270/0260/0264/0278 -- they OVERLAP the
 * 0x1fbf0200..0x1fbf02bf window of the pinctrl driver => the two drivers cannot
 * coexist. The old nodes must go, exactly as in U-Boot patch
 * 110-arm-dts-en7523-add-pinctrl-gpio-support-drop-legacy-.patch.
 */
/delete-node/ &gpio0;
/delete-node/ &gpio1;

/*
 * (C1) `syscon_node_to_regmap()` only accepts a node with compatible "syscon"
 * (drivers/mfd/syscon.c: device_node_get_regmap(np,
 * of_device_is_compatible(np, "syscon"), true)); the `scu:` node of en7523.dtsi
 * (`compatible = "airoha,en7523-scu"`) does NOT have it => add "syscon" here.
 * This does not change clock driver behaviour: it matches the of_match_table
 * entry "airoha,en7523-scu" (still first in the list), and the reg window
 * 0x1fa20000+0x400 fully covers the IOMUX range 0x210..0x224.
 */
&scu {
	compatible = "airoha,en7523-scu", "syscon";
};

/ {
	/*
	 * (C3) SCU register window (0x1fb00000) -- mandatory for the PON driver.
	 *
	 * The en7523.dtsi `scu:` node merges TWO regions:
	 *     reg = <0x1fa20000 0x400>, <0x1fb00000 0x1000>;
	 * but syscon only takes reg[0] (of_syscon_register -> of_address_to_resource
	 * (np, 0)), so the regmap has max_register = 0x3fc. Consequence: every
	 * `airoha-xpon` access to RST_CTRL2 (0x830) / RST_CTRL1 (0x834) -- which live
	 * at 0x1fb00830/0x1fb00834 -- is SILENTLY REFUSED by regmap: writes have no
	 * effect and reads keep returning stack garbage.
	 *
	 * The community tree solves it by SPLITTING into two nodes (chip_scu at
	 * 0x1fa20000 and scuclk at 0x1fb00000) and pointing every consumer at
	 * `airoha,scu = <&scuclk>`. Here the minimal version: one extra syscon node
	 * for the 0x1fb00000 register window only, referenced by the two PON nodes
	 * (see en7523-vgp42x6v1-pon.dtsi). The compatible is deliberately NOT
	 * "airoha,en7523-scu" so the clock/reset driver does not probe twice.
	 */
	scu_reg: syscon@1fb00000 {
		compatible = "airoha,en7523-scu-regs", "syscon";
		reg = <0x1fb00000 0x1000>;
	};

	system-controller@1fbf0200 {
		compatible = "syscon", "simple-mfd";
		/* >= 0x98 (irq_edge/level up to 0x94) and covers LAN_LED1_MAPPING 0x7c.
		 * The vendor DT declares 0x80, which is TOO SMALL. */
		reg = <0x1fbf0200 0xc0>;

		en7523_pinctrl: pinctrl {
			compatible = "airoha,en7523-pinctrl";

			/*
			 * (C2) MANDATORY. Without this phandle
			 * syscon_regmap_lookup_by_compatible("airoha,en7523-chip-scu") returns NULL
			 * (no DTS in the tree declares that compatible) => -ENODEV => probe bails out:
			 * NO gpiochip, and every LED + button is lost. (U-Boot looks up the SCU a
			 * different way, so the blueprint copied from the U-Boot patch misses this
			 * line.)
			 */
			airoha,chip-scu = <&scu>;

			/* platform_get_irq() runs BEFORE devm_gpiochip_add_data() =>
			 * without these two lines the gpiochip is lost. GIC_SPI 26 is correct for the
			 * whole EN7523/AN7581/AN7583 family. */
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH>;

			gpio-controller;
			#gpio-cells = <2>;

			interrupt-controller;
			#interrupt-cells = <2>;

			/* MANDATORY in practice:
			 * airoha_convert_pin_to_reg_offset() uses
			 * pinctrl_find_gpio_range_from_pin_nolock(); without a range => -EINVAL for
			 * every set/get operation.
			 * Row N <-> internal pin N+12 => <&en7523_pinctrl N> ==
			 * <&en7523_pinctrl N>; the number 12 is NOT a row shift. */
			gpio-ranges = <&en7523_pinctrl 0 12 30>;

			/*
			 * No pinctrl-0 is needed to "return the pads to GPIO": patch 203-02
			 * writes 0 to 5 SCU IOMUX registers right in probe --
			 * 0x0210 2ND_I2C_MODE, 0x0214 SPI_CS1_MODE, 0x0218 PON_MODE,
			 * 0x0220 NPU_UART_EN, 0x0224 FORCE_GPIO_EN (EN7523: 0 = GPIO)
			 * -- BEFORE the gpiochip is registered. Those are exactly the bits
			 * holding gpio1/3/11/26.
			 * WARNING: for gpio0..27 there is NO `function = "gpio"`: gpio_groups[]
			 * only declares gpio28/gpio29. Never use `"pwm"` to
			 * "return to GPIO" -- it SETS the PWM bit.
			 * WARNING: REG_GPIO_FLASH_MODE_CFG 0x1fbf0234 / _EXT 0x1fbf0268
			 * are NOT cleared; if a pad is still dead, read those two registers.
			 */
		};
	};
};

/*
 * ------------------------------------------------------------------
 * Front-panel LEDs + buttons (M4.5) -- GPIO numbers MEASURED on real hardware
 * ------------------------------------------------------------------
 * The vendor table `userfs/7523duled.conf` does NOT match this board (see docs section
 * 25.19.11-25.19.13): many pads the vendor marks as LEDs have no LED on this unit, so
 * the numbers below are MEASURED RESULTS, not derived from the vendor table.
 *
 * Measurement method: drive each pad low while all other pads are high, then read
 * back the `data[]` register (0x1fbf0204) to be sure the pad really changed level.
 *
 *   pad 27 -> PWR (blue)   OK: lit right after boot because bit27 of `data[]`
 *                              defaults to 0 -- this is NOT any driver, so
 *                              `default-state = "on"` is required to keep it.
 *   pad 1  -> INT (case prints INET, blue) OK
 *   pad 10 -> PON (green)     OK
 *   pad 6  -> LOS (case prints ALM)  OK  (img15/img16 used pad 6 = WLAN 2.4G: WRONG)
 *   pad 11 -> NO LED (vendor table says PWR) -- this is the root cause of the
 *            "POWER cannot be controlled" bug in img15/img16: the DTS drove
 *            pad 11 while pad 11 is dead.
 *   pad 3, 26 -> NO LED (vendor table says LOS, WPS)
 *   pad 2,4,5,8,9,12..21,28,29 -> NO LED
 *   pad 22..25 -> switch LED pads: muxed to the switch LED engine, so driving
 *            them as GPIO has no effect (the 4 LAN1-4 LEDs still work normally)
 *
 * WARNING: gpio29 = `pcie_reset1` (the vendor table calls it the Internet LED): pulling
 *   it low resets PCIe => WiFi is lost. Do NOT declare an LED for it, do not test it.
 *
 * LAN1-4: driven by the switch LED engine (SCU 0x1fa20210 bits 3/5/7/9 =
 *   LAN0..3_LED0_MODE = 1) => not declared in the DTS and not controllable via
 *   GPIO.
 * 2.4G / 5G: driven by the WiFi module -- `/sys/class/leds/mt76-phy0` and
 *   `mt76-phy1` already exist; they are not SoC GPIOs.
 * WPS: no controllable pad was found (all 28 safe pads were tried, plus holding
 *   the button) => no LED node is declared. The WPS button on gpio7 still works.
 *
 * #gpio-cells = <2> => the polarity GPIO_ACTIVE_LOW is always given.
 * &en7523_pinctrl N == &gpio0 N (internal pin = N + 12).
 */
/ {
	leds {
		compatible = "gpio-leds";

		led_power: led-power {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&en7523_pinctrl 27 GPIO_ACTIVE_LOW>;
			default-state = "on";	/* bit27 defaults to 0 => "on" is required to keep PWR lit as in stock */
		};

		led_pon: led-pon {
			function = "pon";
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&en7523_pinctrl 10 GPIO_ACTIVE_LOW>;	/* measured on real hardware */
		};

		led_los: led-los {
			function = "los";
			color = <LED_COLOR_ID_RED>;
			gpios = <&en7523_pinctrl 6 GPIO_ACTIVE_LOW>;	/* measured on real hardware: pad 6 = LOS/ALM */
		};

		led_inet: led-inet {
			function = "inet";
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&en7523_pinctrl 1 GPIO_ACTIVE_LOW>;	/* measured on real hardware: pad 1 = INET */
		};
	};

	/*
	 * img16: the `airoha,en7523-pinctrl` node DOES have interrupt-controller (GIC SPI 26),
	 * so it now qualifies for switching to `gpio-keys` with real interrupts. This load
	 * still keeps `gpio-keys-polled` so that only ONE variable (pinctrl) changes -- the
	 * 100 ms poll runs fine; switching would need `interrupts` on every child node and
	 * a re-check of the binding first.
	 */
	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <100>;

		key-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&en7523_pinctrl 0 GPIO_ACTIVE_LOW>;	/* proven: log shows pressed/released + reboot */
		};

		key-wps {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&en7523_pinctrl 7 GPIO_ACTIVE_LOW>;	/* dead pad before img16: holding it for 30 s did nothing */
		};
	};
};

/* WiFi MediaTek MT7916 sits on PCIe (kmod-mt7915e + kmod-mt7916-firmware) */
&pcie0 {
	status = "okay";
};

&pcie1 {
	status = "okay";

	/*
	 * The MT7916 is the only device on this bus: /proc/bus/pci shows
	 * `0001:01:00.0`, and domain 1 is pcie@1fa92000 (linux,pci-domain = <1>).
	 * This node exists ONLY to give the radios a MAC.
	 *
	 * The PCI core attaches it to the device whose devfn matches `reg`
	 * (drivers/pci/of.c, of_pci_find_child_device(); no compatible needed), and
	 * mt76_eeprom_override() (eeprom.c of the mt76 package) then walks the
	 * CHILDREN of this node for one whose `reg` equals the band index of the phy
	 * it is overriding -- not the node itself, and not once per chip. Band 0 is
	 * the 2.4 GHz radio, band 1 the 5 GHz one.
	 *
	 * Hence one cell per band. Index 6 = base+6 for 2.4 GHz and 7 = base+7 for
	 * 5 GHz, the mapping this board has always used. A child `reg` matching no
	 * band is ignored, and if a band's cell is missing or invalid the driver
	 * keeps the zero MAC of the default eeprom blob and logs "Invalid MAC
	 * address, using random address" -- a different address on every boot,
	 * which is what happened before this node existed.
	 */
	/*
	 * The MT7916 shows up as 0001:01:00.0 with the integrated root port
	 * 0001:00:01.0 below pcie@1fa92000 (measured: sysfs path
	 * platform/1fa92000.pcie/pci0001:00/0001:00:01.0/0001:01:00.0).  Without
	 * this node the endpoint's PCI bus has no device-tree of_node, so
	 * drivers/pci/of.c pci_set_of_node() bails immediately and the wifi PCI
	 * device runs with fwnode == NULL -- mt76 then cannot walk the band
	 * children and keeps the "Invalid MAC address, using random address"
	 * fallback that used to happen.
	 */
	pci@1,0 {
		reg = <0x00000800 0 0 0 0>;	/* devfn 0x08: bus 0001:00, dev 1, fn 0 */
		device_type = "pci";
		#address-cells = <3>;
		#size-cells = <2>;

		wifi@0,0 {
			reg = <0x00010000 0 0 0 0>;	/* bus 0001:01, dev 0, fn 0 */

			/* The band nodes are addressed by index, not by PCI convention. */
			#address-cells = <1>;
			#size-cells = <0>;

			band@0 {
				reg = <0>;

				nvmem-cells = <&ethaddr 6>;
				nvmem-cell-names = "mac-address";
			};

			band@1 {
				reg = <1>;

				nvmem-cells = <&ethaddr 7>;
				nvmem-cell-names = "mac-address";
			};
		};
	};
};

/*
 * NAND partition table -- EXACTLY per `cat /proc/mtd` on real hardware (2026-10-01).
 * NEVER write to tclinux (slot A), config, reservearea or the raw area at the end of
 * flash (0x6900000-0x8000000 holds the factory/GPON serial + BOB laser + BMT).
 */
&nand {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "bootloader";
			reg = <0x0000000 0x0080000>;
			read-only;
		};

		partition@80000 {
			label = "romfile";
			reg = <0x0080000 0x0040000>;
			read-only;
		};

		partition@c0000 {
			label = "tclinux";		/* slot A -- stock, do not write */
			reg = <0x00C0000 0x2800000>;
			read-only;
		};

		partition@28c0000 {
			label = "tclinux_slave";	/* slot B -- where OpenWrt firmware is written */
			reg = <0x28C0000 0x2800000>;
			/*
			 * The target airoha sysupgrade image is FIT + squashfs:
			 *   offset 0x000000  FIT (kernel lzma)   totalsize ~0x3831AC
			 *   offset 0x3A0000  squashfs "hsqs"
			 * Declare "denx,fit" so CONFIG_MTD_SPLIT_FIT_FW splits it into
			 *   kernel / rootfs / rootfs_data  (see docs/booting.md, section 4.1)
			 * After the split the mtd indices shift (measured, /proc/mtd has 10 partitions):
			 *   mtd4 = kernel, mtd5 = rootfs, mtd6 = rootfs_data,
			 *   mtd7 = data,   mtd8 = config, mtd9 = reservearea.
			 * The running overlay is UBI on mtd7 (data) -- OUTSIDE slot B, so
			 * sysupgrade (which erases mtd3) does not destroy the overlay.
			 */
			compatible = "denx,fit";
		};

		partition@50c0000 {
			label = "data";			/* originally JFFS2 -> now UBI (overlay) */
			reg = <0x50C0000 0x1400000>;
		};

		partition@64c0000 {
			label = "config";
			reg = <0x64C0000 0x0200000>;
			read-only;
		};

		partition@66c0000 {
			label = "reservearea";		/* empty (all 0xFF) but kept read-only */
			reg = <0x66C0000 0x0240000>;
			read-only;
		};

		/*
		 * 0x6900000-0x8000000 (23 MB) = vendor raw area. Only the start of
		 * it is declared below (the read-only "bob" factory block, whose
		 * GPON serial cell the OMCI stack reads); the rest stays
		 * undeclared and is never written.
		 */

		/*
		 * "bob": the vendor factory block. READ-ONLY, never written.
		 *
		 * Why it exists: the OMCI block (net/xpon/omci/identity.c) takes
		 * the GPON serial ONLY through the nvmem cell named
		 * "gpon-serial-number". Without the cell it falls back to
		 * gpon_random_serial_number() and the serial changes on every
		 * boot (measured twice). drivers/mtd/mtdcore.c registers an
		 * nvmem provider for a partition exactly when it carries
		 * "compatible = nvmem-cells", and the cell name follows the node
		 * name, so the child must be named `gpon-serial-number@2bc`.
		 * (The tclinux_slave partition already uses compatible "denx,fit"
		 * and still works, so a non-"fixed-partitions" compatible does not
		 * drop the partition.)
		 *
		 * Why 0x6F00000 + 0x20000: the SPI-NAND is 128 MiB with a 128 KiB
		 * (0x20000) erase block, so a partition must be erase-block
		 * aligned, and 0x6F00000 is already aligned. The area sits outside
		 * every old partition, so sysupgrade never writes there.
		 *
		 * The 12 bytes at +0x2BC are the unit serial (4 vendor characters
		 * + 8 hex digits, the shape omci_normalize_serial() handles in its
		 * own branch). The value is per-unit data and is NOT published in
		 * this repository -- the node only says where the driver looks.
		 */
		partition@6f00000 {
			label = "bob";
			reg = <0x6F00000 0x20000>;
			read-only;

			compatible = "nvmem-cells";
			#address-cells = <1>;
			#size-cells = <1>;

			gpon_serial: gpon-serial-number@2bc {
				reg = <0x2BC 0xC>;
			};
		};

		/*
		 * U-Boot environment -- the only per-unit identity data on this board
		 * that the kernel can read straight out of flash. READ-ONLY, and it is
		 * shared with U-Boot: never write to it from Linux.
		 *
		 * DECLARED LAST ON PURPOSE. An MTD partition's index is its position in
		 * this node, and the vendor U-Boot boots the kernel with
		 * `root=/dev/mtdblock5` (MEASURED, /proc/cmdline). Appending here leaves
		 * mtd0..mtd10 exactly as `cat /proc/mtd` shows them, so that cmdline and
		 * every index in docs/booting.md stay valid. The region OVERLAPS
		 * partition@0 (bootloader); the MTD core does not reject overlapping
		 * partitions -- it only refuses to make a partition that is not
		 * erase-block aligned WRITABLE (drivers/mtd/mtdpart.c,
		 * allocate_partition()), which is what read-only means anyway.
		 *
		 * MECHANISM (why NOT "u-boot,env"): mtdcore registers one nvmem device
		 * per MTD partition (mtd_nvmem_add()), so TWO nvmem devices share this
		 * partition's of_node: mtd11's own nvmem, registered first at partition
		 * creation, and the u-boot,env platform driver's nvmem, registered
		 * later from the platform device. of_nvmem_cell_get() takes the FIRST
		 * nvmem matching the cell's parent node (drivers/nvmem/core.c,
		 * __nvmem_device_get(), bus_find_device()), so every consumer resolved
		 * mtd11's cell-less nvmem and got -ENOENT forever -- MEASURED on
		 * hardware: random MACs for eth and wifi, everything else verified
		 * correct (mtd11 present, u-boot-env0 registered, env CRC valid).
		 *
		 * With "compatible = nvmem-cells" the mtdcore nvmem FOR THIS PARTITION
		 * parses its own children as nvmem cells at registration
		 * (nvmem_add_cells_from_legacy_of() -> nvmem_add_cells_from_dt()) --
		 * exactly the device consumers resolve, so there is no ordering
		 * ambiguity left. "fixed-layout" additionally makes the core apply the
		 * mac-base fixup (nvmem_layout_parse_mac_base()).
		 *
		 * Cell reg (MEASURED with tools/check_dts_mac.py --dump on a LIVE mtd11
		 * read: the vendor upgrade QFLOW writes the environment with its own
		 * variable set, so the `ethaddr=` variable reorders whenever the stock
		 * env is re-saved; the first build shipped 0x372 from a 41-variable
		 * dump and silently missed on the 43-variable live window): the 16 KiB
		 * window holds a 4-byte LE CRC32 then NUL-separated name=value text;
		 * `ethaddr=` sits at 0x197 and its value
		 * ("24:0b:2a:fc:a6:f0", 17 = 0x11 bytes) at 0x19F. 17 bytes is the
		 * documented mac-base ASCII form (nvmem_mac_base_ascii_read():
		 * mac_pton() + eth_addr_add(mac, index), the index coming from
		 * #nvmem-cell-cells -- see GDM1 and the switch ports above). Re-run
		 * --dump on a fresh read whenever the stock firmware touches the env.
		 */
		partition@7c000 {
			label = "u-boot-env";
			reg = <0x07C000 0x4000>;
			read-only;

			compatible = "nvmem-cells", "fixed-layout";
			#address-cells = <1>;
			#size-cells = <1>;

			ethaddr: ethaddr@19f {
				reg = <0x19F 0x11>;
				compatible = "mac-base";
				#nvmem-cell-cells = <1>;
			};
		};
	};
};

/*
 * ------------------------------------------------------------------
 * PON block (gdm2 + xpon + xpon_phy + pon_pcs)
 * ------------------------------------------------------------------
 * MUST be at the END of the file: the included file references `&eth`
 * (the label defined above), so it cannot be included earlier.
 *
 * Deliberate isolation: if the optical block ever breaks booting or the
 * driver, removing exactly this one include line returns the tree to the
 * Ethernet/switch state -- no other node has to change.
 */
#include "en7523-vgp42x6v1-pon.dtsi"
