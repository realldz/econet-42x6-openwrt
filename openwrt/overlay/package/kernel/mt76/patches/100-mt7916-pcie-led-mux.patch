+			 * the 5G LED. See docs/econet/42X6_openwrt_m4_ethernet.md muc 25.23.
+			 */
+			mt76_rmw_field(dev, MT_LED_GPIO_MUX1,
+				       GENMASK(31, 28), 4);
+			break;
 		default:
 			break;
 		}
