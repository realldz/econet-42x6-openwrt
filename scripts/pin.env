# Pinned upstream revision this board support is developed and tested against.
#
# The patch series in openwrt/patches/ has exact context lines, so it is only
# guaranteed to apply to this revision.  Bumping this file means regenerating the
# series (see docs/building.md, "Bumping the pinned revision").
#
# Sourced by scripts/*.sh -- keep it POSIX sh syntax.

# OpenWrt source repository and the exact revision.
OPENWRT_REPO="${OPENWRT_REPO:-https://github.com/openwrt/openwrt.git}"
OPENWRT_COMMIT="9b95be917b2804cf877ca05c078175b37a3a95bf"
OPENWRT_COMMIT_DATE="2026-10-02"
OPENWRT_DESCRIBE="main snapshot, kernel 6.18.54"

# Where the board lives inside the OpenWrt tree.
TARGET="airoha"
SUBTARGET="en7523"
DEVICE_PROFILE="econet_vgp-42x6v1"
DEVICE_TREE="en7523-vgp42x6v1"
KERNEL_SERIES="6.18"

# Artifact directory inside a build tree.
TARGET_BIN="bin/targets/${TARGET}/${SUBTARGET}"
