# Package selection for a vGP-42X6V1 image.
#
# scripts/build-firmware.sh appends these CONFIG_PACKAGE_* lines to the OpenWrt
# .config, runs `make defconfig`, and then verifies that every one of them
# survived -- defconfig silently drops a symbol whose dependencies are missing.
#
# Why this file exists at all: target airoha/en7523 is FEATURES:=source-only, so
# no kmods/ directory is published for it and a kernel module can never be
# installed later from an official feed -- it has to match the exact kernel build.
# Anything an image needs in the way of kmod-* is selected here, or baked in
# through DEVICE_PACKAGES in the device definition.  Userspace packages are not
# affected: they install later from the generic arm_cortex-a7 feeds, and
# docs/packages.md also describes the per-release kmod repository CI publishes.
#
# Rule: the value must be exactly "y", never "m".  CONFIG_PACKAGE_foo=m only
# BUILDS the package; it does not install it into the rootfs, which produces an
# image that is missing files and looks like a driver bug.

# --- Wi-Fi: the AP daemon ---------------------------------------------------
# DEVICE_PACKAGES brings the driver (kmod-mt7915e) and the firmware blobs, but
# that is not enough: without wpad there is no /usr/sbin/hostapd, /etc/init.d/wpad
# starts nothing, and no wlan* netdev ever appears.
CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_PACKAGE_hostapd-utils=y
# iw is used by mac80211.sh when it has to set a MAC or read PHY state.
CONFIG_PACKAGE_iw=y
# iwinfo backs the Wi-Fi pages of the web UI.
CONFIG_PACKAGE_iwinfo=y
# regulatory.db, needed for `option country`.
CONFIG_PACKAGE_wireless-regdb=y

# --- management UI ----------------------------------------------------------
# luci-ssl pulls in uhttpd + libustream-mbedtls + px5g-mbedtls; all of them are
# named explicitly so a feed change cannot silently leave the board without a
# web UI.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y

# --- package manager --------------------------------------------------------
# OpenWrt main ships apk (apk-tools 3.x); opkg no longer exists in the snapshot.
# Note: `apk upgrade` is NOT safe on this board -- several packages in the
# snapshot are built against a different zlib ABI than the image's.  See
# docs/roadmap.md.
CONFIG_PACKAGE_apk-mbedtls=y

# --- diagnostics ------------------------------------------------------------
# iperf3 is the throughput test used for the LAN/Wi-Fi acceptance checks.
CONFIG_PACKAGE_iperf3=y
# i2c-tools: `i2cdetect -y -r 0` looks for the EN7571 laser driver on the
# optical I2C bus at address 0x70 (M3 step 1).  Read mode only -- never write
# to the BOSA/laser.
CONFIG_PACKAGE_i2c-tools=y
# The controller itself is a module (the target sets CONFIG_I2C=m, and Kconfig
# clamps a tristate child to its parent), so it needs a kmod package that is
# selected explicitly -- see openwrt/patches/0005-*.patch, which declares
# kmod-i2c-mt7621.  Without this line the image builds fine but has no driver.
CONFIG_PACKAGE_kmod-i2c-mt7621=y

# --- optical frontend (M3 step 2) -------------------------------------------
# Framework + EN7571 laser-diode driver.  Both kmod packages are declared by
# openwrt/pon/buildroot-patches/0006-*.patch, which --with-pon applies.  Without
them the image still builds
# but the `lddla@70` node has no driver probing it, and nothing reports an
# error -- the same silent-missing-driver trap as kmod-i2c-mt7621 above.
# kmod-airoha-lddla pulls in kmod-optical-frontend (+ kmod-hwmon-core,
# kmod-i2c-core) through DEPENDS.
CONFIG_PACKAGE_kmod-optical-frontend=y
CONFIG_PACKAGE_kmod-airoha-lddla=y

# --- xPON stack (route A) ----------------------------------------------------
# Five kmod packages declared by openwrt/pon/buildroot-patches/0007-*.patch,
# which --with-pon applies (symbols
# CONFIG_XPON / XPON_OMCI / XPON_OAM / PHY_AIROHA_XPON / AIROHA_XPON_V1 = m).
# Selecting kmod-airoha-xpon alone would be enough through DEPENDS, but all
# five are listed explicitly so a changed DEPENDS surfaces at
# `make defconfig` instead of as a silently missing driver.
# No kmod-sfp: the six sfp_bus_*/sfp_upstream_* symbols airoha-xpon.ko
# references live in vmlinux (EXPORT_SYMBOL_GPL), and the module's own
# modinfo lists no dependency beyond the five packages below.
CONFIG_PACKAGE_kmod-xpon=y
CONFIG_PACKAGE_kmod-xpon-omci=y
CONFIG_PACKAGE_kmod-xpon-oam=y
CONFIG_PACKAGE_kmod-phy-airoha-xpon=y
CONFIG_PACKAGE_kmod-airoha-xpon=y

# --- OMCI userspace ----------------------------------------------------------
# omci-agent (ucode binding + rpcd backend + omcictl CLI) and luci-app-omci
# (LuCI pages).  Sources live in openwrt/omci/ and are copied into the tree
# by openwrt/omci/apply-omci.sh, which also synchronises the UAPI header
# (v13 vs v14 mismatch documented in openwrt/omci/README.md).  Copying the
# packages without selecting them here builds nothing -- `make
# package/.../compile` exits 0 without compiling.
CONFIG_PACKAGE_omci-agent=y
CONFIG_PACKAGE_luci-app-omci=y
